### Function for estimating edge parameters given tau using NWR
estimate.theta.fixed.tau <- function (X, tau, pen, nperm = 100, K = 1, symm = "min") {
N <- nrow(X); n <- X[,1] %>% unique() %>% length(); p <- ncol(X) - 3; m <- choose(p, 2)
### Defining response and model matrix for joint methods
y.tilda <- as.vector(as.matrix(X[,-c(1:3)]))
Z.tilda <- transformed.model.matrix(X, tau = tau)
### Determine optimal penalty
# Selecting penalty
if (is.numeric(pen)) {
opt.pen <- pen
} else if (pen %in% c("aic", "bic", "ebic")) {
opt.pen <- tune.fit(x = Z.tilda, y = y.tilda, family = "binomial", penalty = "lasso", tune = pen)$lambda
} else if (pen %in% c("mean", "1se", "max")) {
pens <- vector(mode = "logical", length = nperm)
for (j in 1:nperm) {
yperm <- sample(y.tilda, replace = FALSE, size = length(y.tilda))
pens[j] <- max(abs( ((t(Z.tilda) %*% (yperm - (1/2))) / length(yperm)) ))
}
if (pen == "mean") {
opt.pen <- K*mean(pens)
} else if (pen == "1se") {
opt.pen <- K*(mean(pens) + sd(pens))
} else if (pen == "max") {
opt.pen <- K*max(pens)
}
} else {
return("Error: Invalid penalty criterion provided as input.")
}
### Implement longitudinal nodewise regression
res <- glmnet(x = Z.tilda, y = y.tilda, family = "binomial", alpha = 1,
lambda = opt.pen, intercept = FALSE)
est.coefs <- coef(res)[-1] %>% as.vector()
theta.est <- vec.to.matrix(est.coefs, p = p)
return(theta.est)
}
estimate.parameters.j <- function (X, theta.init = NULL, penalty = "1se", tau.init = 0.5, tol = 1e-3, max.iter = 1000,
nperm = 1000, K = 1, symm = "min") {
N <- nrow(X); p <- ncol(X) - 3; iter <- 1
X <- as.matrix(X)
if (is.null(theta.init)) {
my.vec <- apply(X[,-c(1:3)], MARGIN = 2, FUN = mean)
theta.init <- logit(my.vec) %>% diag()
theta.init <- my.vec %>% diag()
}
theta.old <- theta.init
tau.old <- tau.init
tau.new <- estimate.tau.fixed.theta(X = X, THETA = theta.old)
theta.new <- estimate.theta.fixed.tau(X = X, tau = tau.new, pen = penalty, nperm = nperm, K = K, symm = symm)
while (sum(abs(theta.new - theta.old)) > tol && abs(tau.new - tau.old) > tol && iter < max.iter) {
iter <- iter + 1; theta.old <- theta.new; tau.old <- tau.new
### Step 1: Update tau using the value of theta we obtained
tau.new <- estimate.tau.fixed.theta(X = X, THETA = theta.old)
### Step 2: Update theta using the previous value of tau
theta.new <- estimate.theta.fixed.tau(X = X, tau = tau.new, pen = penalty, nperm = nperm, K = K, symm = symm)
}
return(theta.new)
}
